<?xml version='1.0' encoding='utf-8'?>
<Configuration 
	packages='org.apache.logging.log4j,edu.ucsf.appender,org.javastack.log4j.simplejson,com.splunk.logging,com.mulesoft.ch.logging.appender'
	monitorInterval="30">
	<properties>
		<property name="splunkhttpJson">
			{
			"event":
			{
			"date": "%d{yyyy-MM-dd HH:mm:ss.SSS}",
			"serviceName":"${sys:app.name}"
			},
			"logText":"%json{%m}"
			}%n
		</property>
		<property name="jsonlayout">{"properties":{"contentType":"application/json;charset=UTF-8"},"body":"%json{{"event":{"severity":"%p","logger":"%c","thread":"%json{%t},"mdc":"%json{%MDC}","message":{"event":{"date":"%d{yyyy-MM-dd
			HH:mm:ss.SSS}","serviceName":"${sys:app.name}"},"logText":"%json{%m}"}}}}"}
		</property>
		<!-- Define environment mappings -->
		<Property name="environment.dev">dev</Property>
		<Property name="environment.stage">stage</Property>
		<Property name="environment.production">prod</Property>
	</properties>
	<Appenders>
		<RollingFile name="file"
			fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}its-scuba-eds.log"
			filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}its-scuba-eds-%i.log">
			<PatternLayout
				pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n" />
			<SizeBasedTriggeringPolicy size="10 MB" />
			<DefaultRolloverStrategy max="10" />
		</RollingFile>
		<AnypointMqAppender name='anypointmq'
			url='https://mq-us-west-2.anypoint.mulesoft.com/api/v1/organizations/fd48cc65-d939-425c-a990-099a23d246ae/environments/${sys:env.id}/destinations/${sys:env}-splunk/messages/'
			method='PUT' clientId='${sys:anypointmq.clientid}'
			clientSecret='${sys:anypointmq.clientsecret}'>
			<Property name='Content-Type' value='application/json' />
			<PatternLayout pattern="${jsonlayout}" charset="UTF-8" />
		</AnypointMqAppender>

		<SplunkHttp name="Splunk"
			url="https://splunkindexer.ucsfmedicalcenter.org"
			token="${sys:splunk.token}"
			index="${environment.${lower:${sys:environment}}}_mule_app_logs"
			source="${sys:app.name}" sourceType="mule-app" messageFormat="json"
			batch_size_count="${sys:batch_size_count}"
			batch_interval="${sys:batch_interval}"
			batch_size_bytes="${sys:batch_size_bytes}"
			disableCertificateValidation="true">
			<PatternLayout pattern="${splunkhttpJson}"
				charset="UTF-8" />
		</SplunkHttp>
		<Failover name="failover_appender" primary="Splunk">
			<Failovers>
				<AppenderRef ref="anypointmq" />
			</Failovers>
		</Failover>
	</Appenders>
	<Loggers>
		<!-- Http Logger shows wire traffic on DEBUG. -->
		<!-- <AsyncLogger name='org.mule.service.http.impl.service.HttpMessageLogger' 
			level='DEBUG' /> -->
		<AsyncLogger name='org.mule.service.http' level='WARN' />
		<AsyncLogger name='org.mule.extension.http' level='WARN' />

		<!-- Mule logger -->
		<AsyncLogger
			name='org.mule.runtime.core.internal.processor.LoggerMessageProcessor'
			level='INFO' />
		<AsyncRoot>
			<appenderRef ref="failover_appender" />
		</AsyncRoot>
	</Loggers>
</Configuration>